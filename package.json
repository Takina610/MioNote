{
  "name": "mionote",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "把散落在硬盘上的笔记文件夹变成一个能读、能搜的本地阅读器",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run scripts/build-site.ts",
    "build:spa": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "sync": "bun run scripts/sync-content.ts",
    "publish": "bun run scripts/publish.ts",
    "publish:dry": "bun run scripts/publish.ts --dry-run",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "android:build:debug": "tauri android build --debug --apk"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "aws4fetch": "^1.0.20",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "material-icon-theme": "^5.38.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
