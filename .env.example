# 发布凭证模板。
#
# 复制成 .env.local 再填真实值：
#     cp .env.example .env.local
#
# 为什么是 .env.local：.gitignore 里的 `*.local` 已经覆盖了它，
# 所以这些值不会被提交。仓库里任何被提交的文件都不含凭证——
# 只有 scripts/publish.ts 会读这个文件，Vite 插件和浏览器都碰不到它。

# Cloudflare 账号 ID（控制台右侧栏，或任意 R2 页面的 URL 里）
R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → Create API Token
# 权限选 Object Read & Write，只授予这一个桶
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 桶名。不填就用 vault.config.ts 里 deploy.r2.bucket 的值
# R2_BUCKET=mionote-assets

# 公共访问域名，影响线上图片的 URL。**bun run build 需要它**（没有就构建不了，
# 因为图片 URL 拼不出来）。两种选择：
#   1. 自定义域名（推荐）：R2 → 你的桶 → Settings → Public access → Custom Domains
#      https://img.example.com
#   2. 试水用的 r2.dev 地址：打开 Public Development URL 会得到
#      https://pub-xxxxxxxx.r2.dev —— 能用，但 Cloudflare 明确说它有限流，不适合生产
#
# 换了域名之后要重跑 bun run publish（账本里记着上次用的域名，会因此重传一遍）。
# R2_PUBLIC_BASE=https://img.example.com
